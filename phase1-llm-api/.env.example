# 阶段 1 环境变量模板
# 用法：复制本文件为 .env（同目录），填入真实值。
#   PowerShell:  Copy-Item .env.example .env
# .env 已被仓库根目录 .gitignore 忽略，绝不会进 Git。真实密钥只写进 .env，永远不写进代码。

# ---------- 通用后端配置（ex03_switch_backend.py 与项目①靠这三个切后端） ----------
# 只要是 OpenAI 兼容接口，换掉这三个值就能切后端，代码一行不用动。
# 中转站:       https://你的中转站域名/v1      ← 当前使用
# 本地 Ollama:  http://localhost:11434/v1
# DeepSeek:     https://api.deepseek.com/v1
# 阿里百炼:      https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://你的中转站域名/v1
LLM_API_KEY=sk-你的中转站key
# 模型 id 必须与中转站「可用模型列表」里的字符串完全一致（大小写、连字符都不能差）
LLM_MODEL=gpt-5.6-sol

# ---------- 中转站（第三方 OpenAI 兼容代理，当前主力） ----------
# 注意：key 与全部对话内容都会经过第三方服务器，别放任何敏感数据；建议小额充值、单独一把 key。
RELAY_BASE_URL=https://你的中转站域名/v1
RELAY_API_KEY=sk-你的中转站key

# ---------- DeepSeek 云端（备用） ----------
# 申请地址：https://platform.deepseek.com/  注册后在「API keys」创建，充 10 元够用整个阶段
DEEPSEEK_API_KEY=

# ---------- 阿里云百炼（多模态 qwen-vl-plus / qwen-vl-max 用它） ----------
# 申请地址：https://bailian.console.aliyun.com/  新用户有免费额度
DASHSCOPE_API_KEY=

# ---------- OpenAI（可选，没有也不影响本阶段学习） ----------
# 申请地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------- 本地 Ollama ----------
# 默认端口 11434；OpenAI 兼容端点要带 /v1 后缀
OLLAMA_BASE_URL=http://localhost:11434
# 模型存放目录建议设到非 C 盘（这一条是设给 Ollama 服务本身的系统环境变量，不是给 Python 读的）
# OLLAMA_MODELS=E:\ollama\models

# ---------- 代理（本机有 SOCKS 代理时按需开启） ----------
# httpx 已装 socks extra，可直接用 socks5:// 协议
# ALL_PROXY=socks5://127.0.0.1:1080
